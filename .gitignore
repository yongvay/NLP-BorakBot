# --- Secrets: add these BEFORE the first commit ---
.env
.env.*
*.key
kaggle.json

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Virtual environments ---
venv/
.venv/
env/
malaya-env/

# --- Model weights and adapters: these go to Hugging Face Hub ---
*.safetensors
*.bin
*.pt
*.pth
*.gguf
saves/
checkpoints/
outputs/
adapter/
models/
.cache/
huggingface/

# --- Whisper model cache ---
whisper_models/

# --- Databases: commit schema.sql, not the data ---
*.db
*.sqlite
*.sqlite3
feedback.db

# --- Audio: test recordings are large and not source ---
# Phone voice memos are usually .mp4 or .3gp containers, not just .m4a -- so those are
# listed too. The manifest is the source of truth; the audio itself lives in Drive.
*.wav
*.mp3
*.m4a
*.mp4
*.aac
*.3gp
*.ogg
*.opus
*.flac
recordings/
eval/speech/audio/
eval/speech/raw/

# --- Intermediate generation runs (commit only the validated dataset) ---
data/generated/raw/
data/generated/tmp/
data/**/*.tmp.jsonl

# --- Logs ---
*.log
logs/
wandb/
runs/

# --- Streamlit ---
.streamlit/secrets.toml

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/settings.json
.idea/
